---
import { socials } from '../data/socials';

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-600 mt-16">
  <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-500">
    <span>&copy; {year} Cuberact</span>
    <div class="flex gap-6 items-center">
      {socials.map(({ href, label, path, footerBg }) => (
        <a href={href}
           class:list={[footerBg, 'inline-flex items-center gap-1 text-white px-3 py-1 rounded text-xs font-medium hover:brightness-110 transition']}>
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d={path}/></svg>
          {label}
        </a>
      ))}
    </div>
  </div>
</footer>
