---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
}

const { title, description, date, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="bg-surface-800 rounded-lg p-6 border border-surface-600">
  <time class="text-xs text-gray-500 uppercase tracking-widest">{formattedDate}</time>
  <h2 class="text-xl text-white mt-2 mb-2">{title}</h2>
  <p class="text-gray-400 text-sm mb-4">{description}</p>
  <a href={`/blog/${slug}/`} class="text-brand-blue-light hover:text-white text-xs uppercase tracking-widest transition-colors">Read post &rarr;</a>
</article>
