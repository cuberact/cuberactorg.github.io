---
import { socials } from '../data/socials';

const navLinks = [
  { href: '/projects/', label: 'Projects' },
  { href: '/demo/', label: 'Demo' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-surface-600">
  <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <img src="/images/cuberact-logo-64.png" alt="Cuberact" width="32" height="32" />
      <span class="font-heading font-light text-xl text-white tracking-wider">CUBERACT</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      <ul class="flex gap-8">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'text-sm uppercase tracking-widest transition-colors',
                currentPath.startsWith(href)
                  ? 'text-brand-blue-light'
                  : 'text-gray-400 hover:text-white',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-3 ml-2">
        {socials.map(({ href, label, path, headerColor }) => (
          <a href={href} class:list={[headerColor, 'hover:text-white transition-colors']} aria-label={label} title={label}>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d={path}/></svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden text-gray-400 hover:text-white"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4">
    <ul class="space-y-2">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block py-2 text-sm uppercase tracking-widest',
              currentPath === href
                ? 'text-brand-blue-light'
                : 'text-gray-400 hover:text-white',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex gap-4 pt-3 mt-3 border-t border-surface-600">
      {socials.map(({ href, label, path, headerColor }) => (
        <a href={href} class:list={[headerColor, 'hover:text-white transition-colors']} aria-label={label} title={label}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d={path}/></svg>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
