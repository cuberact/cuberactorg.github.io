---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GodotEmbed from '../../components/GodotEmbed.astro';
---

<BaseLayout title="Planet Chunked LOD Demo - Cuberact" description="Fly from orbit to the surface of a procedurally generated planet - running in your browser.">
  <section class="max-w-3xl mx-auto px-4 pt-10 md:pt-12 pb-12 md:pb-16 text-center">
    <p class="text-brand-blue-light text-sm uppercase tracking-widest mb-1">Procedural planet</p>
    <h1 class="text-3xl md:text-4xl text-white mb-2">Planet Chunked LOD</h1>
    <p class="text-gray-400">
      Fly from orbit down to the surface of a procedurally generated planet. Dynamic level-of-detail, atmosphere, and day/night cycle - all in your browser.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-24">
    <details class="mb-6">
      <summary class="cursor-pointer text-brand-blue-light hover:text-white text-sm transition-colors">Controls</summary>
      <div class="prose prose-invert prose-gray max-w-none mt-2">
        <table>
          <thead><tr><th>Key</th><th>Action</th></tr></thead>
          <tbody>
            <tr><td>W / A / S / D</td><td>Move forward / left / backward / right</td></tr>
            <tr><td>R / F</td><td>Rise / fall</td></tr>
            <tr><td>Q / E</td><td>Roll left / right</td></tr>
            <tr><td>Mouse</td><td>Look around (click to capture, ESC to release)</td></tr>
            <tr><td>Scroll wheel</td><td>Adjust speed multiplier</td></tr>
            <tr><td>H</td><td>Reset camera to starting position</td></tr>
            <tr><td>Tab</td><td>Debug observer mode</td></tr>
            <tr><td>F1</td><td>Toggle wireframe</td></tr>
            <tr><td>F2</td><td>Toggle shader (terrain / simple colors)</td></tr>
            <tr><td>F3</td><td>Toggle lighting</td></tr>
            <tr><td>F4</td><td>Toggle atmosphere</td></tr>
            <tr><td>F5</td><td>Toggle terrain collision</td></tr>
            <tr><td>O / P</td><td>Time of day &minus; / +</td></tr>
            <tr><td>Space</td><td>Collapse / expand HUD</td></tr>
            <tr><td>F12</td><td>Show/hide controls overlay</td></tr>
          </tbody>
        </table>
      </div>
    </details>

    <div class="md:hidden bg-surface-800 border border-yellow-600/40 rounded-lg p-5 mb-6 text-center">
      <p class="text-yellow-500 font-semibold mb-1">Best on desktop</p>
      <p class="text-gray-400 text-sm">
        This demo requires a keyboard and mouse. For the best experience, open this page on a computer.
      </p>
    </div>

    <GodotEmbed
      src="/godot-demos/planet-chunked-lod/index.html"
      title="Planet Chunked LOD"
      width={1920}
      height={1080}
    />

    <div class="text-center mt-6">
      <a
        href="/projects/planet-chunked-lod/"
        class="text-brand-blue-light hover:text-white text-sm uppercase tracking-widest transition-colors"
      >
        Learn more about Planet Chunked LOD &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
