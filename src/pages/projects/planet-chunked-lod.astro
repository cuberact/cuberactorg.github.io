---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { socials } from '../../data/socials';

const iconPath = (label: string) => socials.find((s) => s.label === label)?.path;
const links = [
  { href: 'https://github.com/cuberact/godot-cuberact-planet-chunked-lod', label: 'GitHub', path: iconPath('GitHub'), primary: true },
  { href: 'https://www.youtube.com/watch?v=yK8nJxmXAgo', label: 'YouTube', path: iconPath('YouTube') },
  { href: '/demo/planet-chunked-lod/', label: 'Web demo →' },
];
---

<BaseLayout title="Planet Chunked LOD - Cuberact" description="Procedurally generated planet with dynamic LOD, written entirely in GDScript for Godot 4.6.">
  <section class="max-w-4xl mx-auto px-4 pt-10 md:pt-12 pb-12 md:pb-16 space-y-12">

    <!-- Header -->
    <div>
      <h1 class="text-3xl md:text-4xl text-white mb-4">Planet Chunked LOD</h1>
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300">GDScript</span>
        <span class="px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300">Godot 4.6+</span>
        <span class="px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300">Open Source</span>
        <span class="px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300">MIT License</span>
      </div>
      <p class="text-gray-400 text-lg max-w-3xl">
        A procedurally generated planet with dynamic level-of-detail, written entirely in GDScript for Godot 4.6.
        Fly from orbit all the way down to the surface - the mesh adapts continuously.
        Designed as a <strong class="text-gray-300">learning resource</strong>.
      </p>
    </div>

    <!-- Hero image -->
    <div>
      <img
        src="/images/planet.jpg"
        alt="Planet from orbit"
        width="1920"
        height="1080"
        class="w-full rounded-lg border border-surface-600"
      />
    </div>

    <!-- Origin story -->
    <div class="bg-surface-800 rounded-lg border border-surface-600 p-6">
      <h2 class="text-white text-lg mb-2">Origin story</h2>
      <p class="text-gray-400 text-sm">
        I originally built this as a Java project about 15 years ago using the Ardor3D engine.
        That engine no longer exists and the project couldn't even run anymore.
        So I rewrote it from scratch in pure GDScript for Godot - intentionally keeping it simple and readable.
      </p>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap gap-3">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'inline-flex items-center gap-2 px-4 py-2 rounded text-sm transition',
            l.primary
              ? 'bg-brand-blue text-white hover:brightness-110'
              : 'bg-surface-800 border border-surface-600 text-gray-300 hover:border-brand-blue-light hover:text-white',
          ]}
        >
          {l.path && <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={l.path} /></svg>}
          {l.label}
        </a>
      ))}
    </div>

    <!-- Key features -->
    <div>
      <h2 class="text-white text-xl mb-6">Key features</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Quadtree LOD</h3>
          <p class="text-gray-400 text-sm">Each cube face is a quadtree. Chunks split near the camera and merge far away. Hysteresis prevents flickering, frame budget prevents stutter.</p>
        </div>
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Shader terrain</h3>
          <p class="text-gray-400 text-sm">All terrain - geometry, color, textures, lighting - is computed by a single GLSL shader. 4 noise layers: continental, mountains, detail, micro.</p>
        </div>
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Atmosphere</h3>
          <p class="text-gray-400 text-sm">Rayleigh scattering computed per-pixel via ray marching. Blue sky from the surface, thin glow from orbit, sunset tones at the terminator.</p>
        </div>
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Origin shifting</h3>
          <p class="text-gray-400 text-sm">The world moves around the camera to keep vertex calculations near the origin. No jittering at planetary distances - no engine recompilation needed.</p>
        </div>
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Frustum & horizon culling</h3>
          <p class="text-gray-400 text-sm">Hierarchical frustum culling with AABB + angular horizon culling. Chunks behind the planet's curvature are skipped entirely.</p>
        </div>
        <div class="bg-surface-800 rounded-lg p-5 border border-surface-600">
          <h3 class="text-white text-sm font-semibold mb-2">Pure GDScript</h3>
          <p class="text-gray-400 text-sm">No C++, no GDExtensions, no plugins. Just open the project in Godot and hit Play. Designed to be readable and easy to learn from.</p>
        </div>
      </div>
    </div>

    <!-- Screenshots -->
    <div>
      <h2 class="text-white text-xl mb-6">Screenshots</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <img src="/images/planet-s01.jpg" alt="High altitude view" class="rounded-lg border border-surface-600 w-full" />
        <img src="/images/planet-s02.jpg" alt="Mountains" class="rounded-lg border border-surface-600 w-full" />
        <img src="/images/planet-s03.jpg" alt="Surface with grass" class="rounded-lg border border-surface-600 w-full" />
        <img src="/images/planet-s04.jpg" alt="Coastline" class="rounded-lg border border-surface-600 w-full" />
        <img src="/images/planet-s05.jpg" alt="Debug mode" class="rounded-lg border border-surface-600 w-full" />
        <img src="/images/planet-s06.jpg" alt="Sunset" class="rounded-lg border border-surface-600 w-full" />
      </div>
    </div>

    <!-- Rendering pipeline -->
    <div>
      <h2 class="text-white text-xl mb-4">Rendering pipeline</h2>
      <p class="text-gray-400 text-sm mb-4">The planet is rendered in five stages:</p>
      <ol class="space-y-3 text-sm">
        <li class="flex gap-3">
          <span class="text-brand-blue-light font-semibold shrink-0">1.</span>
          <div><strong class="text-gray-300">Cube &rarr; Sphere</strong> <span class="text-gray-400">- Start with a cube. Project each face onto a sphere using the spherified cube mapping for uniform vertex distribution.</span></div>
        </li>
        <li class="flex gap-3">
          <span class="text-brand-blue-light font-semibold shrink-0">2.</span>
          <div><strong class="text-gray-300">Quadtree LOD</strong> <span class="text-gray-400">- Subdivide each face into a recursive tree of chunks. Split near the camera, merge far away.</span></div>
        </li>
        <li class="flex gap-3">
          <span class="text-brand-blue-light font-semibold shrink-0">3.</span>
          <div><strong class="text-gray-300">Mesh building</strong> <span class="text-gray-400">- Each chunk is a 17&times;17 grid on the sphere. Chunks are recycled from a pool. Split reuses ~28% of parent vertices.</span></div>
        </li>
        <li class="flex gap-3">
          <span class="text-brand-blue-light font-semibold shrink-0">4.</span>
          <div><strong class="text-gray-300">Shader terrain</strong> <span class="text-gray-400">- A GPU shader displaces vertices with procedural noise and colors everything per-pixel: ocean, grass, rock, snow, triplanar textures, Lambert lighting.</span></div>
        </li>
        <li class="flex gap-3">
          <span class="text-brand-blue-light font-semibold shrink-0">5.</span>
          <div><strong class="text-gray-300">Atmosphere</strong> <span class="text-gray-400">- A second shader renders Rayleigh scattering on a transparent sphere. Blue sky, sunset glow, star blending.</span></div>
        </li>
      </ol>
    </div>

    <!-- Getting started -->
    <div>
      <h2 class="text-white text-xl mb-4">Getting started</h2>
      <div class="bg-surface-800 rounded-lg border border-surface-600 p-6">
        <ol class="space-y-2 text-gray-400 text-sm">
          <li>1. Clone the repository</li>
          <li>2. Open in Godot 4.6+</li>
          <li>3. Press F5 (or click Play)</li>
        </ol>
        <p class="text-gray-500 text-sm mt-3">No build steps, no dependencies, no setup.</p>
      </div>
    </div>

    <!-- License -->
    <div class="bg-surface-800 rounded-lg border border-surface-600 p-6">
      <h2 class="text-white text-lg mb-2">License</h2>
      <p class="text-gray-400 text-sm">
        MIT - use it however you like. The full README includes a detailed implementation deep dive
        covering every technique used in the project.
      </p>
    </div>

  </section>
</BaseLayout>
