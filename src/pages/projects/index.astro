---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'cuberact-library',
    href: '/projects/cuberact-library/',
    description: 'A growing collection of GDExtension components for Godot 4.5+. Currently includes CRope2D - 2D rope physics with modular architecture.',
    tags: ['GDExtension', 'GDScript', 'Open Source Examples', 'Godot 4.5+'],
    version: 'v1.1.0',
    image: '/images/cuberact-library-examples/e01-jellyfish.jpg',
    imageAlt: 'CRope2D jellyfish scene - bioluminescent bells over a seagrass meadow',
  },
  {
    title: 'Planet Chunked LOD',
    href: '/projects/planet-chunked-lod/',
    description: 'Procedurally generated planet with dynamic level-of-detail, written entirely in GDScript for Godot 4.6. A learning resource - from orbit to the surface.',
    tags: ['GDScript', 'Open Source', 'Godot 4.6+'],
    image: '/images/planet.jpg',
    imageAlt: 'Procedurally generated planet from orbit with atmosphere',
  },
];
---

<BaseLayout title="Projects - Cuberact" description="Tools, extensions, and games by Cuberact.">
  <section class="max-w-5xl mx-auto px-4 pt-10 md:pt-12 pb-12 md:pb-16">
    <h1 class="sr-only">Projects</h1>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(({ title, href, description, tags, version, image, imageAlt }) => (
        <div class="bg-surface-800 rounded-lg border border-surface-600 overflow-hidden flex flex-col">
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-3">
              <h2 class="text-white text-xl">{title}</h2>
              {version && <span class="px-2 py-0.5 text-sm rounded bg-brand-blue/20 text-brand-blue-light font-medium shrink-0">{version}</span>}
            </div>
            <div class="flex flex-wrap gap-2 mb-3">
              {tags.map((t) => (
                <span class="inline-block px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300">{t}</span>
              ))}
            </div>
            <p class="text-gray-400 text-sm mb-4">{description}</p>
            <a href={href} class="mt-auto text-brand-blue-light hover:text-white text-xs uppercase tracking-widest transition-colors">Open project &rarr;</a>
          </div>
          <img src={image} alt={imageAlt} class="w-full aspect-video object-cover" />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
