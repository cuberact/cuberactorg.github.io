---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'cuberact-library',
    tag: 'GDExtension',
    version: 'v1.0.0',
    image: '/images/crope2d.jpg',
    imageAlt: 'CRope2D playground — ropes, collisions, and physics in action',
    description: '2D rope physics for Godot 4.5+. Verlet integration, collisions, anchoring, breaking, and a fully modular architecture. 14 example scenes included.',
    demoHref: '/demo/crope2d/',
    projectHref: '/projects/cuberact-library/',
  },
  {
    title: 'Planet Chunked LOD',
    tag: 'GDScript · Open Source',
    image: '/images/planet.jpg',
    imageAlt: 'Procedurally generated planet from orbit with atmosphere',
    description: 'Procedurally generated planet with dynamic level-of-detail, written entirely in GDScript for Godot 4.6. Fly from orbit to the surface — the mesh adapts continuously.',
    demoHref: '/demo/planet-chunked-lod/',
    projectHref: '/projects/planet-chunked-lod/',
  },
];
---

<BaseLayout title="Cuberact">
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 py-24 md:py-32 text-center">
    <img
      src="/images/cuberact-logo-512.png"
      alt="Cuberact logo"
      width="160"
      height="160"
      class="mx-auto mb-6"
    />
    <img
      src="/images/cuberact-text-512.png"
      alt="CUBERACT"
      width="320"
      class="mx-auto mb-8"
    />
    <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-4">
      Indie studio making games, tools, and extensions.
    </p>
    <p class="text-base text-gray-500 max-w-2xl mx-auto">
      I'm building tools and games with Godot Engine — from physics extensions to procedural planets.
      Everything here is made to be useful, playable, and open to learn from.
    </p>
  </section>

  <!-- Projects -->
  <section class="max-w-5xl mx-auto px-4 pb-24">
    <p class="text-brand-blue-light text-sm uppercase tracking-widest text-center mb-10">News</p>

    <div class="grid md:grid-cols-2 gap-8">
      {projects.map(({ title, tag, version, image, imageAlt, description, demoHref, projectHref }) => (
        <div class="bg-surface-800 rounded-lg border border-surface-600 overflow-hidden">
          <a href={projectHref} class="block group">
            <img
              src={image}
              alt={imageAlt}
              class="w-full aspect-video object-cover group-hover:brightness-110 transition"
            />
          </a>
          <div class="p-6">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-white text-lg">{title}</h3>
              {version && <span class="px-2 py-0.5 text-xs rounded bg-brand-blue/20 text-brand-blue-light shrink-0 ml-2">{version}</span>}
            </div>
            <span class="inline-block px-2 py-0.5 text-xs rounded bg-surface-600 text-gray-300 mb-3">{tag}</span>
            <p class="text-gray-400 text-sm mb-4">{description}</p>
            <div class="flex gap-4">
              <a
                href={demoHref}
                class="inline-block px-4 py-2 bg-brand-blue text-white text-xs uppercase tracking-widest rounded hover:brightness-110 transition"
              >
                Try demo &rarr;
              </a>
              <a
                href={projectHref}
                class="text-brand-blue-light hover:text-white text-xs uppercase tracking-widest transition-colors self-center"
              >
                Learn more &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
